<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="theme-color" content="#101827"><title>QuickSpark Studio 2.0</title>
<style>
:root{--bg:#0b1220;--panel:#121d30;--line:#2a3a54;--text:#f4f7fb;--muted:#a9b7ca;--gold:#f8b84e}*{box-sizing:border-box}body{margin:0;background:radial-gradient(circle at 90% 0%,#243858,transparent 35%),var(--bg);color:var(--text);font:15px/1.45 system-ui,Arial,sans-serif}header,main{max-width:1120px;margin:auto;padding:18px 16px}.brand{font-weight:950;font-size:1.25rem}.brand span{color:var(--gold)}.pill{float:right;color:#9ee5bd;border:1px solid #37634f;border-radius:30px;padding:5px 9px;font-size:.75rem}.intro{margin:10px 0 22px}.eyebrow{color:var(--gold);font-weight:800;letter-spacing:1.3px;text-transform:uppercase;font-size:.75rem}h1{font-size:clamp(2rem,6vw,3rem);line-height:1.08;margin:8px 0}.muted,.hint{color:var(--muted)}.tabs{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:15px}.tabs button{width:auto;margin:0;background:#263954;color:var(--text);padding:9px 12px}.tabs button.active{background:var(--gold);color:#1a2535}.section{display:none}.section.active{display:block}.layout{display:grid;grid-template-columns:minmax(280px,.85fr) minmax(300px,1.15fr);gap:16px;align-items:start}.panel{background:linear-gradient(155deg,#152239,#101a2b);border:1px solid var(--line);border-radius:18px;padding:17px;box-shadow:0 15px 40px #0003}.panel h2{font-size:1.1rem;margin:0 0 5px}.hint{font-size:.83rem;margin:0 0 14px}label{display:block;font-size:.86rem;font-weight:700;margin:12px 0 5px}input,select,textarea{width:100%;padding:11px 12px;border:1px solid #40536e;border-radius:10px;background:#0a1525;color:var(--text);font:inherit;min-height:43px}textarea{min-height:65px;resize:vertical}input[type=color]{height:44px;padding:4px}.colors,.row{display:grid;grid-template-columns:1fr 1fr;gap:10px}.templates{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin:10px 0}.template{border:1px solid #40536e;background:#0b1729;color:var(--text);border-radius:11px;padding:10px 5px;cursor:pointer;text-align:center;font-size:.8rem}.template.active{border-color:var(--gold);box-shadow:0 0 0 1px var(--gold)}button{border:0;border-radius:11px;background:var(--gold);color:#1a2535;font-weight:850;padding:12px 14px;font:inherit;cursor:pointer;width:100%;margin-top:10px}button.alt{background:#263954;border:1px solid #48617f;color:var(--text)}button.danger{background:#4b2930;color:#ffe4e4}.canvaswrap{background:#091321;border:1px dashed #4b607c;border-radius:14px;padding:12px;display:flex;justify-content:center;overflow:hidden}canvas{display:block;width:100%;height:auto;max-height:68vh;object-fit:contain;border-radius:7px}.saved{display:grid;gap:8px;margin-top:10px}.saveditem{display:flex;justify-content:space-between;align-items:center;gap:8px;background:#0b1729;border:1px solid var(--line);border-radius:10px;padding:9px;font-size:.84rem}.saveditem button{width:auto;margin:0;padding:7px 10px;font-size:.78rem}.status{display:none;margin-top:10px;background:#18372c;color:#c8f5da;padding:10px;border-radius:9px;font-size:.85rem}.warning{background:#382f1c;color:#ffe5a8;padding:11px;border-radius:10px;font-size:.82rem;margin-top:12px}.fine{font-size:.75rem;color:var(--muted);margin-top:10px}@media(max-width:800px){.layout{grid-template-columns:1fr}.canvaswrap canvas{max-height:none}.panel{padding:14px}}
</style></head><body>
<header><span class="pill">VERSION 2.0 · DESIGNER PREVIEW</span><div class="brand">⚡ Quick<span>Spark</span> Studio</div></header>
<main><section class="intro"><div class="eyebrow">Small business creative studio</div><h1>Make your next promotion stand out.</h1><p class="muted">Create editable promotional graphics, choose social sizes, and download PNGs directly from your tablet.</p></section>
<div class="tabs"><button class="active" data-tab="studio">Design studio</button><button data-tab="saved">Saved designs</button><button data-tab="orders">Order dashboard</button><button data-tab="account">Account preview</button></div>
<section id="studio" class="section active"><div class="layout"><div class="panel">
<h2>1. Choose a format</h2><p class="hint">Pick the size where you'll publish your design.</p><label for="format">Social image dimensions</label><select id="format"><option value="1080,1080">Instagram square · 1080 × 1080</option><option value="1080,1350" selected>Instagram portrait · 1080 × 1350</option><option value="1200,630">Facebook landscape · 1200 × 630</option></select>
<h2 style="margin-top:18px">2. Choose a template</h2><div class="templates"><button class="template active" data-template="bold">Bold offer</button><button class="template" data-template="clean">Clean & modern</button><button class="template" data-template="event">Grand opening</button></div>
<h2 style="margin-top:18px">3. Edit your content</h2><label for="business">Business name</label><input id="business" value="YOUR BUSINESS"><label for="headline">Headline</label><textarea id="headline">A GREAT DEAL IS HERE!</textarea><label for="offer">Offer details</label><textarea id="offer">20% OFF YOUR FIRST SERVICE</textarea><label for="cta">Call to action</label><input id="cta" value="BOOK TODAY"><label for="footer">Extra details (optional)</label><input id="footer" value="Locally owned · Friendly service">
<h2 style="margin-top:18px">4. Customize colors</h2><div class="colors"><div><label for="background">Background</label><input type="color" id="background" value="#101827"></div><div><label for="accent">Accent</label><input type="color" id="accent" value="#f8b84e"></div></div><button id="render">Update design</button><div class="fine">Your design is generated in this browser. Download a PNG to save it to your tablet.</div>
</div><div class="panel"><h2>Live design preview</h2><p class="hint" id="sizeLabel">Instagram portrait · 1080 × 1350</p><div class="canvaswrap"><canvas id="art" width="1080" height="1350"></canvas></div><div class="row"><button id="download">Download PNG</button><button class="alt" id="save">Save design</button></div><div id="status" class="status" role="status"></div><div class="warning">Saved designs stay in this browser on this device only. They are not synced to an online customer account.</div></div></div></section>
<section id="saved" class="section"><div class="panel"><h2>Your saved designs</h2><p class="hint">Designs saved in this browser are listed here.</p><div id="savedList" class="saved"></div><button class="alt" id="backStudio">Back to studio</button></div></section>
<section id="orders" class="section"><div class="panel"><h2>Order dashboard preview</h2><p class="hint">This is a local demonstration of the future owner dashboard.</p><div class="warning">No customer orders or payments are being received yet. This preview does not represent real orders.</div><div class="saveditem"><span>Starter · 1 design · $9</span><span>Sample package</span></div><div class="saveditem"><span>Business · 3 designs · $19</span><span>Sample package</span></div><div class="saveditem"><span>Premium · 5 designs · $29</span><span>Sample package</span></div></div></section>
<section id="account" class="section"><div class="panel"><h2>Customer account preview</h2><p class="hint">Real sign-in will be connected after secure backend setup.</p><label for="email">Email address</label><input id="email" type="email" placeholder="you@example.com"><label for="password">Password</label><input id="password" type="password" placeholder="Not connected yet" disabled><button class="alt" disabled>Sign in (backend not connected)</button><div class="warning">Do not enter a real password here. This is a design preview only; there is no authentication yet.</div></div></section></main>
<script>
const $=id=>document.getElementById(id),canvas=$('art'),ctx=canvas.getContext('2d');let template='bold';
function vals(){return{business:$('business').value,headline:$('headline').value,offer:$('offer').value,cta:$('cta').value,footer:$('footer').value,bg:$('background').value,accent:$('accent').value,format:$('format').value,template}}
function wrap(t,x,y,mw,lh,ml,fs,color,weight='700'){ctx.font=`${weight} ${fs}px system-ui,Arial`;ctx.fillStyle=color;let line='',lines=[];for(const word of String(t||'').split(/\s+/)){let test=line?line+' '+word:word;if(ctx.measureText(test).width>mw&&line){lines.push(line);line=word}else line=test}if(line)lines.push(line);lines.slice(0,ml).forEach((l,i)=>ctx.fillText(l,x,y+i*lh))}
function draw(){let d=vals(),[w,h]=d.format.split(',').map(Number),s=Math.min(w,h),p=s*.075;canvas.width=w;canvas.height=h;ctx.fillStyle=d.bg;ctx.fillRect(0,0,w,h);if(d.template==='bold'){ctx.globalAlpha=.14;ctx.fillStyle=d.accent;ctx.beginPath();ctx.arc(w*.88,h*.12,s*.28,0,Math.PI*2);ctx.fill();ctx.globalAlpha=1;ctx.fillStyle=d.accent;ctx.fillRect(p,p,s*.2,Math.max(9,s*.012))}else if(d.template==='clean'){ctx.strokeStyle=d.accent;ctx.lineWidth=Math.max(5,s*.008);ctx.strokeRect(p*.55,p*.55,w-p*1.1,h-p*1.1)}else{ctx.fillStyle=d.accent;ctx.fillRect(0,0,w,h*.19);ctx.fillStyle=d.bg;ctx.beginPath();ctx.arc(w*.5,h*.19,s*.16,0,Math.PI);ctx.fill()}let fg=d.bg.toLowerCase()==='#ffffff'?'#182235':'#ffffff',top=d.template==='event'?h*.31:h*.24;ctx.textAlign='center';wrap(d.business,w/2,top*.55,w-p*2,s*.07,2,s*.065,d.template==='clean'?fg:d.accent,'900');wrap(d.headline,w/2,top+s*.18,w-p*2,s*.09,3,s*.085,fg,'900');ctx.fillStyle=d.accent;ctx.fillRect(w*.36,h*.59,w*.28,Math.max(8,s*.012));wrap(d.offer,w/2,h*.72,w-p*2,s*.075,3,s*.07,fg,'850');let bx=w*.18,by=h*.84,bw=w*.64,bh=Math.max(55,h*.075);ctx.fillStyle=d.accent;ctx.beginPath();ctx.roundRect(bx,by,bw,bh,Math.min(24,bh*.22));ctx.fill();ctx.fillStyle='#172235';ctx.font=`900 ${s*.045}px system-ui`;ctx.fillText(d.cta.toUpperCase(),w/2,by+bh*.64);ctx.fillStyle='#cbd5e1';ctx.font=`500 ${s*.027}px system-ui`;ctx.fillText(d.footer,w/2,h*.95);ctx.textAlign='left';$('sizeLabel').textContent=`${w>h?'Facebook landscape':w===h?'Instagram square':'Instagram portrait'} · ${w} × ${h}`}
function notify(t){$('status').style.display='block';$('status').textContent=t}
document.querySelectorAll('[data-tab]').forEach(b=>b.onclick=()=>{document.querySelectorAll('[data-tab]').forEach(x=>x.classList.toggle('active',x===b));document.querySelectorAll('.section').forEach(x=>x.classList.toggle('active',x.id===b.dataset.tab));if(b.dataset.tab==='saved')showSaved()});
document.querySelectorAll('[data-template]').forEach(b=>b.onclick=()=>{template=b.dataset.template;document.querySelectorAll('[data-template]').forEach(x=>x.classList.toggle('active',x===b));draw()});
['business','headline','offer','cta','footer','background','accent','format'].forEach(id=>$(id).addEventListener('input',draw));$('render').onclick=draw;
$('download').onclick=()=>{draw();let a=document.createElement('a');a.download='quickspark-design.png';a.href=canvas.toDataURL('image/png');a.click();notify('PNG download started. Check your tablet Downloads folder.')};
function list(){try{return JSON.parse(localStorage.getItem('qs_designs')||'[]')}catch(e){return[]}}
$('save').onclick=()=>{let d=vals();d.id=Date.now();d.title=d.business+' — '+d.headline;let a=list();a.unshift(d);localStorage.setItem('qs_designs',JSON.stringify(a.slice(0,30)));notify('Design saved on this device only.')};
function showSaved(){$('savedList').innerHTML='';let a=list();if(!a.length){$('savedList').textContent='No saved designs yet.';return}a.forEach(d=>{let r=document.createElement('div');r.className='saveditem';let n=document.createElement('span');n.textContent=d.title;let actions=document.createElement('div'),open=document.createElement('button'),del=document.createElement('button');open.textContent='Open';open.onclick=()=>{['business','headline','offer','cta','footer','background','accent','format'].forEach(k=>$(k).value=d[k]);template=d.template;document.querySelectorAll('[data-template]').forEach(x=>x.classList.toggle('active',x.dataset.template===template));document.querySelector('[data-tab="studio"]').click();draw()};del.textContent='Delete';del.className='danger';del.onclick=()=>{localStorage.setItem('qs_designs',JSON.stringify(list().filter(x=>x.id!==d.id)));showSaved()};actions.append(open,del);r.append(n,actions);$('savedList').append(r)})}
$('backStudio').onclick=()=>document.querySelector('[data-tab="studio"]').click();draw();
</script></body></html>